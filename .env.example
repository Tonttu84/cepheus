# Documented local-only connection for offline development with embedded PostgreSQL.
# The user "cepheus" and password "cepheus-local-only" are documented local-only values, not secrets.
DATABASE_URL="postgresql://cepheus:cepheus-local-only@localhost:5433/cepheus"

# 32+ byte random secret for sealing HttpOnly OAuth/session cookies in production.
# Leave empty in local development to use an ephemeral runtime key.
APP_SESSION_SECRET=""

# Fitbit Web API OAuth2 (PKCE) configuration (optional; leave empty for simulated mode).
FITBIT_CLIENT_ID=""
FITBIT_CLIENT_SECRET=""
FITBIT_REDIRECT_URI=""

# Set to "true" ONLY when deployed behind a trusted reverse proxy that sets x-forwarded-for.
TRUST_PROXY_HEADERS=""

# Shared bearer token (or per-device SHA-256 hashes JSON) for Arduino UNO Q ingest (/api/arduino/ingest).
# ARDUINO_DEVICE_KEYS_JSON format: {"unoq-home-01":{"tokenHash":"<sha256-hex>","revoked":false}}
ARDUINO_INGEST_TOKEN=""
ARDUINO_DEVICE_KEYS_JSON=""

# Shared secret for Android/iOS Health Connect webhook (/api/webhooks/health-connect).
# Used for X-Signature: sha256=<HMAC> (Life Dashboard Companion) or Bearer / X-Webhook-Token.
HEALTH_CONNECT_WEBHOOK_SECRET=""

# EU-hosted Verda Inference API serving open-weight Gemma (Trail #31).
# Off by default ("false"); falls back deterministically unless enabled and configured.
VERDA_AI_ENABLED="false"
VERDA_INFERENCE_URL=""
VERDA_API_KEY=""
VERDA_GEMMA_MODEL=""
