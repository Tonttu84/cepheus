// ============================================================================
// Cepheus — Unified Prisma Schema (PostgreSQL, Step 2: aligned with decisions)
// ============================================================================
// Core Repository Rules enforced by this schema:
//   - Pseudonymous patients (`Participant.participantCode` / `externalId`),
//     no patient names, emails, phone numbers, DOBs, or national IDs.
//     Clinic staff accounts (`StaffUser`) are the only named accounts.
//   - No free text stored anywhere in this build (`freeTextNote` and
//     `summaryNote` removed).
//   - Twice-weekly check-in uses 2 taps (moodScore, interestScore: 0..4);
//     missed or "not_today" rounds keep null scores, never coerced to 0.
//   - PHQ-9 tracks roundNumber & in_progress state; self-harm item > 0
//     produces a `CrisisEvent` row separate from `ClinicFlag`.
//   - Three consent layers (`takingPart`, per-method `MeasurementConsent`,
//     `ruleCheckConsent`) recorded as immutable `ConsentEvent` rows.
//   - Clinic flags (`ClinicFlag`) expose only broad life areas, `sinceDate`,
//     triggerKind, and ruleVersion — never raw answers or sensor numbers.
//   - Every read/write/delete decision is recorded in `AccessLog` (keyed by
//     `patientCode`, never answers) and survives participant deletion.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Clinic organization owning pseudonymous patients and staff accounts.
model Clinic {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants          Participant[]
  staffUsers            StaffUser[]
  enrolmentCodes        EnrolmentCode[]
  consents              MeasurementConsent[]
  consentEvents         ConsentEvent[]
  checkInRounds         CheckInRound[]
  phq9Assessments       Phq9Assessment[]
  ringDays              RingDay[]
  activitySamples       ActivitySample[]
  rhythmWindows         RhythmWindow[]
  cameraReadings        CameraReading[]
  speechReadings        SpeechReading[]
  cognitiveGameReadings CognitiveGameReading[]
  routineSignalReadings RoutineSignalReading[]
  personalBaselines     PersonalBaseline[]
  patientSuggestions    PatientSuggestion[]
  clinicFlags           ClinicFlag[]
  nurseCallRecords      NurseCallRecord[]
  crisisEvents          CrisisEvent[]
  smallDips             SmallDip[]
  baselineNotices       BaselineNotice[]
  extraAnswers          ExtraAnswer[]
  gad7Assessments       Gad7Assessment[]
}

/// Named clinic staff account (nurse or admin). The only named people in the DB.
model StaffUser {
  id               String   @id @default(cuid())
  clinicId         String
  clinic           Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  email            String   @unique
  name             String
  role             String   @default("nurse") // "nurse" | "admin"
  twoFactorEnabled Boolean  @default(false)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  nurseCalls               NurseCallRecord[]
  acknowledgedCrisisEvents CrisisEvent[]

  @@index([clinicId])
}

/// Pseudonymous participant profile (simulated trajectory, open dataset, or live patient).
/// Never store real patient names, phone numbers, emails, DOBs, or national IDs here.
model Participant {
  id                 String   @id @default(cuid())
  clinicId           String?
  clinic             Clinic?  @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  externalId         String?  @unique
  participantCode    String?  @unique
  label              String // Anonymous label, e.g. "Simulated post-TMS participant"
  source             String // "synthetic" | "depresjon" | "kossakowski" | "oura" | "live"
  isSimulated        Boolean  @default(true)
  seed               Int?
  enrolmentDate      String? // "YYYY-MM-DD"
  scheduleDaysJson   String? // JSON tuple of 2 ISO weekdays, e.g. "[1,4]"
  scheduleTime       String? // "HH:MM"
  timeZone           String   @default("Europe/Helsinki")
  takingPart         Boolean  @default(false)
  ruleCheckConsent   Boolean  @default(false)
  questionnairesJson String? // JSON array of "phq9" | "gad7"; null means the default set
  tmsCompletedDate   String?
  currentDemoDay     Int      @default(56)
  // Study-only fields for open datasets or synthetic trajectories; always null for live patients:
  group              String?
  age                Int?
  gender             String?
  madrsBaseline      Int?
  madrsEnd           Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  enrolmentCodes        EnrolmentCode[]
  consents              MeasurementConsent[]
  consentEvents         ConsentEvent[]
  checkInRounds         CheckInRound[]
  phq9Assessments       Phq9Assessment[]
  ringDays              RingDay[]
  activitySamples       ActivitySample[]
  rhythmWindows         RhythmWindow[]
  cameraReadings        CameraReading[]
  speechReadings        SpeechReading[]
  cognitiveGameReadings CognitiveGameReading[]
  routineSignalReadings RoutineSignalReading[]
  personalBaselines     PersonalBaseline[]
  patientSuggestions    PatientSuggestion[]
  clinicFlags           ClinicFlag[]
  nurseCallRecords      NurseCallRecord[]
  crisisEvents          CrisisEvent[]
  smallDips             SmallDip[]
  baselineNotices       BaselineNotice[]
  extraAnswers          ExtraAnswer[]
  gad7Assessments       Gad7Assessment[]

  @@index([clinicId])
}

/// One-time clinic-issued code (stored as SHA-256 hash) to sign a patient's phone in.
model EnrolmentCode {
  id            String       @id @default(cuid())
  clinicId      String
  clinic        Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  participantId String?
  participant   Participant? @relation(fields: [participantId], references: [id], onDelete: Cascade)
  codeHash      String       @unique
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime     @default(now())

  @@index([clinicId])
  @@index([participantId])
}

/// Per-method consent state and plain-language transparency about what is recorded.
model MeasurementConsent {
  id                  String      @id @default(cuid())
  participantId       String
  participant         Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  clinicId            String?
  clinic              Clinic?     @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  method              String // "check_in" | "phq9" | "ring_rhythm" | "camera_expressivity" | "speech_rate" | "ambiguous_faces" | "home_routine" | "financial_routine"
  broadArea           String // "check_in" | "sleep" | "daily_routine" | "activity_outside_home" | "financial_routine"
  recordedDescription String
  enabled             Boolean     @default(true)
  isPersonalSign      Boolean     @default(false)
  consentedAt         DateTime?
  revokedAt           DateTime?
  updatedAt           DateTime    @updatedAt

  @@unique([participantId, method])
  @@index([clinicId])
}

/// Append-only record of every consent change across the three layers (taking_part, method, rule_check).
model ConsentEvent {
  id            String      @id @default(cuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  clinicId      String?
  clinic        Clinic?     @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  layer         String // "taking_part" | "method" | "rule_check"
  method        String? // Present when layer === "method"
  enabled       Boolean
  noticeVersion String      @default("v1")
  recordedAt    DateTime    @default(now())

  @@index([participantId, recordedAt])
  @@index([clinicId])
}

/// Twice-weekly short wellbeing check-in round (two taps: moodScore and interestScore, 0..4).
/// Missed answers are recorded as status = "missed" or "not_today" and never scored as 0.
model CheckInRound {
  id                String      @id @default(cuid())
  participantId     String
  participant       Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  clinicId          String?
  clinic            Clinic?     @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  scheduledAt       DateTime
  respondedAt       DateTime?
  reminderSentAt    DateTime?
  date              String // "YYYY-MM-DD"
  dayIndex          Int
  weekNumber        Int
  roundNumber       Int
  status            String // "completed" | "not_today" | "missed" | "open" (reminder sent, no outcome yet)
  moodScore         Int? // 0..4 ("very low" .. "very good")
  interestScore     Int? // 0..4 ("not at all" .. "very much")
  itemOrderJson     String?
  responseLatencyMs Int?
  ringActiveAtRound Boolean?
  isSimulated       Boolean     @default(false)
  source            String      @default("live")
  createdAt         DateTime    @default(now())

  @@unique([participantId, roundNumber])
  @@index([participantId, date])
  @@index([clinicId])
}

/// Fortnightly PHQ-9 assessment (9 items rated 0..3).
/// Supports "in_progress" across rounds; any item9SelfHarm > 0 creates a CrisisEvent immediately.
model Phq9Assessment {
  id                     String      @id @default(cuid())
  participantId          String
  participant            Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  clinicId               String?
  clinic                 Clinic?     @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  scheduledAt            DateTime
  completedAt            DateTime?
  date                   String // "YYYY-MM-DD"
  dayIndex               Int
  weekNumber             Int
  roundNumber            Int
  completedInRoundNumber Int?
  status                 String // "completed" | "in_progress" | "missed"
  totalScore             Int? // 0..27
  item1Interest          Int?
  item2Mood              Int?
  item3Sleep             Int?
  item4Energy            Int?
  item5Appetite          Int?
  item6SelfWorth         Int?
  item7Concentration     Int?
  item8Psychomotor       Int?
  item9SelfHarm          Int?
  baselineDelta          Int?
  isSimulated            Boolean     @default(false)
  source                 String      @default("live")
  createdAt              DateTime    @default(now())

  @@unique([participantId, roundNumber])
  @@index([participantId, date])
  @@index([clinicId])
}

/// Urgent crisis event generated immediately when PHQ-9 item 9 > 0 (separate from ClinicFlag).
model CrisisEvent {
  id                    String      @id @default(cuid())
  participantId         String
  participant           Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  clinicId              String?
  clinic                Clinic?     @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  roundNumber           Int
  itemId                String      @default("item9SelfHarm")
  value                 Int
  occurredAt            DateTime    @default(now())
  acknowledgedAt        DateTime?
  acknowledgedByStaffId String?
  acknowledgedByStaff   StaffUser?  @relation(fields: [acknowledgedByStaffId], references: [id], onDelete: SetNull)
  isSimulated           Boolean     @default(false)

  @@unique([participantId, roundNumber])
  @@index([clinicId, acknowledgedAt])
}

/// Immutable audit entry for access checks. Keyed by pseudonymous `patientCode` (no answers)
/// so logs remain intact when a participant requests data deletion.
model AccessLog {
  id              String   @id @default(cuid())
  clinicId        String?
  actorKind       String // "patient" | "staff" | "system"
  actorId         String?
  patientCode     String?
  action          String // "read" | "write" | "delete"
  targetKind      String
  purpose         String
  allowed         Boolean
  reason          String
  timestamp       DateTime @default(now())
  actorClinicId   String?
  actorRole       String? // "nurse" | "admin" when actorKind is "staff"
  targetPatientId String? // The patient id as it was asked for; it can name no stored patient
  targetMethod    String?

  @@index([clinicId, timestamp])
  @@index([patientCode, timestamp])
  @@index([targetPatientId, timestamp])
}

/// Daily smart-ring summary plus compact 24h hourly array and 1440-min sleep/wake string
/// for fast non-parametric circadian rhythm (IS, IV, RA, SRI) calculations.
model RingDay {
  id                    String      @id @default(cuid())
  participantId         String
  participant           Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  clinicId              String?
  clinic                Clinic?     @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  date                  String // "YYYY-MM-DD"
  dayIndex              Int
  ringActive            Boolean     @default(true)
  wearMinutes           Int         @default(1400)
  steps                 Int?
  activeCaloriesKcal    Float?
  daytimeMeanActivity   Float?
  nighttimeMeanActivity Float?
  m10                   Float?
  l5                    Float?
  relativeAmplitude     Float?
  hourlyActivityJson    String? // JSON array of 24 hourly mean activity floats, clock hours 0..23
  bedtimeStart          DateTime?
  bedtimeEnd            DateTime?
  sleepMidpointMin      Float? // Minutes relative to midnight, e.g. -45 for 23:15, +195 for 03:15
  timeInBedMin          Float?
  totalSleepMin         Float?
  onsetLatencyMin       Float?
  wasoMinutes           Float?
  nightActivityBouts    Int?
  lowestHrBpm           Float?
  avgHrBpm              Float?
  avgHrvRmssdMs         Float?
  tempDeviationC        Float?
  sleepWakeGrid         String? // 1440-char string of '0'=wake and '1'=sleep for exact per-minute SRI
  sleepPhase5MinRaw     String?
  isSimulated           Boolean     @default(false)
  source                String      @default("synthetic")
  createdAt             DateTime    @default(now())

  @@unique([participantId, date])
  @@index([participantId, dayIndex])
  @@index([clinicId])
}

/// Optional fine-grained per-minute or 5-minute actigraphy rows for open datasets (e.g. Depresjon CSV).
model ActivitySample {
  id            String      @id @default(cuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  clinicId      String?
  clinic        Clinic?     @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  timestamp     DateTime
  date          String
  resolutionSec Int         @default(60)
  activityCount Float?
  met           Float?
  isAsleep      Boolean?
  source        String      @default("depresjon")

  @@index([participantId, timestamp])
  @@index([participantId, date])
  @@index([clinicId])
}

/// Rolling 7- or 14-day circadian and sleep regularity metrics compared against personal baseline.
model RhythmWindow {
  id                    String      @id @default(cuid())
  participantId         String
  participant           Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  clinicId              String?
  clinic                Clinic?     @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  windowEndDate         String
  dayIndex              Int
  windowDays            Int         @default(7)
  validDays             Int
  m10                   Float
  l5                    Float
  relativeAmplitude     Float
  interdailyStability   Float
  intradailyVariability Float
  sri                   Float?
  sleepMidpointSdMin    Float?
  wasoMeanMin           Float?
  stepsMean             Float?
  raZScore              Float?
  isZScore              Float?
  sriZScore             Float?
  isSimulated           Boolean     @default(false)

  @@unique([participantId, windowEndDate, windowDays])
  @@index([clinicId])
}

/// On-device MediaPipe facial expressivity & head-kinematics reading.
/// Stores ONLY derived numerical summary statistics — never video or image frames.
model CameraReading {
  id                   String      @id @default(cuid())
  participantId        String
  participant          Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  clinicId             String?
  clinic               Clinic?     @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  recordedAt           DateTime    @default(now())
  date                 String // "YYYY-MM-DD"
  dayIndex             Int?
  taskId               String      @default("check_in_clip_60s")
  durationSec          Float
  sampleRateHz         Float       @default(10.0)
  effectiveFps         Float
  faceDetectedRatio    Float
  expressivityScore    Float
  smileFraction        Float
  mouthSmileMean       Float?
  mouthSmileSd         Float?
  browInnerUpSd        Float?
  browDownSd           Float?
  browOuterUpSd        Float?
  eyeSquintSd          Float?
  cheekSquintSd        Float?
  jawOpenSd            Float?
  blendshapeStatsJson  String?
  yawSdDeg             Float
  pitchSdDeg           Float
  rollSdDeg            Float?
  angularPathDegPerMin Float
  translationSd        Float?
  expressivityZScore   Float?
  headMovementZScore   Float?
  isSimulated          Boolean     @default(false)
  source               String      @default("live")

  @@index([participantId, date])
  @@index([clinicId])
}

/// Optional 30s scripted read-aloud timing & pause summary.
/// Stores ONLY derived timing numbers — never audio recordings or transcripts.
model SpeechReading {
  id                        String      @id @default(cuid())
  participantId             String
  participant               Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  clinicId                  String?
  clinic                    Clinic?     @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  recordedAt                DateTime    @default(now())
  date                      String
  dayIndex                  Int?
  passageId                 String      @default("standard_passage_1")
  syllableCount             Int
  readingTimeSec            Float
  speakingTimeSec           Float
  pauseTimeSec              Float
  speechRateSylPerSec       Float
  articulationRateSylPerSec Float
  pauseCountOver250ms       Int
  meanPauseLengthMs         Float
  pauseRatio                Float
  noiseFloorDb              Float?
  speechRateZScore          Float?
  isSimulated               Boolean     @default(false)
  source                    String      @default("live")

  @@index([participantId, date])
  @@index([clinicId])
}

/// Optional weekly ambiguous-faces / scenarios rating game summary.
model CognitiveGameReading {
  id                      String      @id @default(cuid())
  participantId           String
  participant             Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  clinicId                String?
  clinic                  Clinic?     @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  recordedAt              DateTime    @default(now())
  date                    String
  dayIndex                Int?
  taskType                String      @default("ambiguous_faces")
  trialCount              Int
  validTrialCount         Int
  negativeRatingCount     Int
  positiveRatingCount     Int
  interpretationBiasScore Float
  meanReactionTimeMs      Float?
  biasZScore              Float?
  isSimulated             Boolean     @default(false)
  source                  String      @default("live")

  @@index([participantId, date])
  @@index([clinicId])
}

/// Optional derived home or financial routine counts — never raw transactions or sensor traces.
model RoutineSignalReading {
  id              String      @id @default(cuid())
  participantId   String
  participant     Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  clinicId        String?
  clinic          Clinic?     @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  periodStartDate String
  periodEndDate   String
  dayIndex        Int?
  channel         String // "laundry" | "shower_humidity" | "kitchen_motion" | "financial_routine"
  broadArea       String // "daily_routine" | "financial_routine"
  derivedValue    Float
  unit            String
  baselineZScore  Float?
  isSimulated     Boolean     @default(false)
  source          String      @default("synthetic")

  @@index([participantId, channel, periodEndDate])
  @@index([clinicId])
}

/// Per-participant personal baseline statistics anchored on initial well weeks post-TMS.
model PersonalBaseline {
  id              String      @id @default(cuid())
  participantId   String
  participant     Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  clinicId        String?
  clinic          Clinic?     @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  metricName      String
  windowStartDate String
  windowEndDate   String
  sampleCount     Int
  mean            Float
  sd              Float
  median          Float?
  iqr             Float?
  updatedAt       DateTime    @updatedAt

  @@unique([participantId, metricName])
  @@index([clinicId])
}

/// One-button low-effort state-shifter suggestion for small dips (no follow-up mood questions).
model PatientSuggestion {
  id               String      @id @default(cuid())
  participantId    String
  participant      Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  clinicId         String?
  clinic           Clinic?     @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  createdAt        DateTime    @default(now())
  date             String
  dayIndex         Int?
  reason           String // "small_dip" | "practice"
  actionKey        String // "short_walk" | "breathing_space" | "bright_light" | "social_contact"
  actionTitle      String
  actionDetail     String?
  effortTier       String      @default("low")
  status           String      @default("shown") // "shown" | "accepted" | "completed" | "skipped"
  respondedAt      DateTime?
  armType          String      @default("intervention")
  nextCheckInDelta Float?
  isSimulated      Boolean     @default(false)

  @@index([participantId, date])
  @@index([clinicId])
}

/// Clinic-side flag naming only broad area(s), triggerKind, ruleVersion, and sinceDate — never answers or raw sensors.
model ClinicFlag {
  id                      String            @id @default(cuid())
  participantId           String
  participant             Participant       @relation(fields: [participantId], references: [id], onDelete: Cascade)
  clinicId                String?
  clinic                  Clinic?           @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  createdAt               DateTime          @default(now())
  sinceDate               String // "YYYY-MM-DD"
  dayIndex                Int?
  triggerKind             String // "low_answers" | "silence" | "mixed" | "phq9" | "sustained_dip"
  ruleVersion             Int               @default(1)
  primaryArea             String // "check_in" | "sleep" | "daily_routine" | "activity_outside_home" | "financial_routine"
  broadAreasJson          String // JSON array of broad area keys
  status                  String            @default("open") // "open" | "nurse_call_requested" | "booster_offered" | "watching" | "resolved"
  ringActiveDuringSilence Boolean?
  patientSharedDetails    Boolean           @default(false)
  sharedAt                DateTime?
  isSimulated             Boolean           @default(false)
  causeType               String? // "round" | "phq9" | "gad7": what made the rule raise this flag
  causeRoundNumber        Int? // Present when causeType is "round"
  causeDate               String? // "YYYY-MM-DD"; the cause holds no score and no answer
  nurseCalls              NurseCallRecord[]

  @@index([participantId, status])
  @@index([clinicId, status])
}

/// Nurse call outreach record and post-warning clinical action outcome (no free-text notes).
model NurseCallRecord {
  id                     String      @id @default(cuid())
  flagId                 String?
  flag                   ClinicFlag? @relation(fields: [flagId], references: [id], onDelete: SetNull)
  participantId          String
  participant            Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  clinicId               String?
  clinic                 Clinic?     @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  staffUserId            String?
  staffUser              StaffUser?  @relation(fields: [staffUserId], references: [id], onDelete: SetNull)
  requestedAt            DateTime    @default(now())
  completedAt            DateTime?
  status                 String      @default("requested") // "requested" | "completed" | "unreachable"
  outcomeTier            String? // "rough_patch" | "sustained_decline" | "full_relapse" | "crisis" | "false_alarm"
  actionTaken            String? // "advice_and_medication_check" | "booster_tms_cluster" | "new_tms_course_referral" | "urgent_care" | "none"
  medicationChecked      Boolean     @default(false)
  watchNextRounds        Int         @default(0)
  boosterSessionsPlanned Int?
  isSimulated            Boolean     @default(false)
  date                   String? // "YYYY-MM-DD" local date on which the call took place; null until then
  position               String? // "before" | "after": the call's place relative to the round of that date

  @@index([participantId, requestedAt])
  @@index([clinicId])
  @@index([staffUserId])
}

/// A small dip found by the warning rule. It makes the one suggestion wait for the patient.
/// The cause holds a round or a date only, never a score or an answer.
model SmallDip {
  id               String      @id @default(cuid())
  participantId    String
  participant      Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  clinicId         String?
  clinic           Clinic?     @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  roundNumber      Int
  date             String // "YYYY-MM-DD"
  ruleVersion      Int
  causeType        String // "round" | "phq9" | "gad7"
  causeRoundNumber Int?
  causeDate        String
  shownAt          DateTime

  @@index([participantId, roundNumber])
  @@index([clinicId])
}

/// Notice to the clinic that the first complete PHQ-9 (the baseline) was at or above the cut-off.
/// The cause holds a date only, never the score.
model BaselineNotice {
  id               String      @id @default(cuid())
  participantId    String
  participant      Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  clinicId         String?
  clinic           Clinic?     @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  ruleVersion      Int
  causeType        String // "round" | "phq9" | "gad7"
  causeRoundNumber Int?
  causeDate        String
  notifiedAt       DateTime

  @@index([participantId])
  @@index([clinicId])
}

/// Answer to the experimental rotating extra question (D25), at most one per round.
/// Never used by the warning rule, the baselines or the flags.
model ExtraAnswer {
  id            String      @id @default(cuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  clinicId      String?
  clinic        Clinic?     @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  roundNumber   Int
  itemId        String
  value         Int // 0..4
  answeredAt    DateTime

  @@unique([participantId, roundNumber])
  @@index([clinicId])
}

/// GAD-7 questionnaire of a round (D35), following Phq9Assessment. The seven item
/// columns stay null unless STORE_ITEM_ANSWERS is on; a completed one keeps its total.
model Gad7Assessment {
  id                  String      @id @default(cuid())
  participantId       String
  participant         Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  clinicId            String?
  clinic              Clinic?     @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  scheduledAt         DateTime
  completedAt         DateTime?
  date                String // "YYYY-MM-DD"
  dayIndex            Int
  weekNumber          Int
  roundNumber         Int
  status              String // "completed" | "in_progress"
  totalScore          Int? // 0..21
  item1Nervous        Int?
  item2ControlWorry   Int?
  item3ExcessiveWorry Int?
  item4Relaxing       Int?
  item5Restless       Int?
  item6Irritable      Int?
  item7Afraid         Int?
  isSimulated         Boolean     @default(false)
  source              String      @default("live")
  createdAt           DateTime    @default(now())

  @@unique([participantId, roundNumber])
  @@index([participantId, date])
  @@index([clinicId])
}
